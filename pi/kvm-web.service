[Unit]
Description=DIY PiKVM web control plane (FastAPI -> HID)
After=network-online.target kvm-gadget.service
Wants=network-online.target
Requires=kvm-gadget.service

[Service]
Type=simple
# Unprivileged service. It writes /dev/hidg* via the 'diykvm' group (udev rule), opens serial
# ports via 'dialout', drives the power GPIO via 'gpio' (/dev/gpiochip*), and performs the
# privileged virtual-drive / config transitions through "sudo kvm-*-helper" (see
# /etc/sudoers.d/diykvm). NoNewPrivileges/PrivateTmp are intentionally NOT set: sudo needs them
# off, and the helper's mount must stay visible here.
User=diykvm
Group=diykvm
SupplementaryGroups=dialout gpio
RuntimeDirectory=kvm
WorkingDirectory=/opt/kvm/app
EnvironmentFile=-/etc/kvm/kvm.env
ExecStart=/opt/kvm/venv/bin/python /opt/kvm/app/server.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
