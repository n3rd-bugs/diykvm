# The unprivileged diykvm web service may run only these fixed helper verbs as root —
# the mass-storage transitions, and the validating config writer / streamer restart. Nothing else.
diykvm ALL=(root) NOPASSWD: /usr/local/sbin/kvm-msd-helper attach, /usr/local/sbin/kvm-msd-helper detach, /usr/local/sbin/kvm-msd-helper eject, /usr/local/sbin/kvm-msd-helper import, /usr/local/sbin/kvm-msd-helper delete, /usr/local/sbin/kvm-conf-helper write, /usr/local/sbin/kvm-conf-helper restart-streamer, /usr/local/sbin/kvm-gadget-helper reenumerate
